<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <!-- Запись в файл -->
    <File name="MyFileAppender" fileName="logs/application.log" append="true">
      <PatternLayout>
        <Pattern>%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %logger{36} - %msg%n</Pattern>
      </PatternLayout>
    </File>

    <!-- Вывод в консоль (чтобы видеть процесс в реальном времени) -->
    <Console name="MyConsoleAppender" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss} %-5level - %msg%n"/>
    </Console>
  </Appenders>

  <Loggers>
    <!-- Уровень TRACE гарантирует запись всех типов сообщений -->
    <Root level="TRACE">
      <AppenderRef ref="MyFileAppender"/>
      <AppenderRef ref="MyConsoleAppender"/>
    </Root>
  </Loggers>
</Configuration>